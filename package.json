{
  "name": "afterleaf",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "content:import-cbz": "bun scripts/content-import-cbz.ts",
    "content:prepare": "bun scripts/content-prepare.ts",
    "content:seed": "bun scripts/content-seed.ts",
    "content:sync:nhentai": "bun scripts/content-sync-nhentai.ts",
    "library:scan": "bun scripts/library-scan.ts",
    "library:fetch-more": "bun scripts/library-fetch-more.ts",
    "library:blacklist": "bun scripts/library-blacklist.ts",
    "tv:analyze": "bun scripts/tv-analyze.ts",
    "chrome:profile:wsl": "bash scripts/cdp/start-chrome-wsl.sh",
    "cdp:navigate:wsl": "bash scripts/cdp/run-wsl.sh bun scripts/cdp/navigate.ts",
    "cdp:profile:wsl": "bash scripts/cdp/run-wsl.sh bun scripts/cdp/profile-renderer.ts",
    "cdp:console:wsl": "bash scripts/cdp/run-wsl.sh bun scripts/cdp/collect-console.ts",
    "cdp:screenshot:wsl": "bash scripts/cdp/run-wsl.sh bun scripts/cdp/capture-screenshot.ts",
    "format": "oxfmt --config .oxfmtrc.json --write .",
    "format:check": "oxfmt --config .oxfmtrc.json --list-different .",
    "lint": "oxlint --config .oxlintrc.json . --fix --quiet",
    "lint:check": "oxlint --config .oxlintrc.json .",
    "type-check": "tsc6 --noEmit",
    "test:unit": "bun test --only-failures src",
    "check": "bun run format && bun run lint && bun run type-check && bun run test:unit && bun run build",
    "check:ci": "bun run format:check && bun run lint:check && bun run type-check && bun run test:unit && bun run build"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "node-unrar-js": "^2.0.2",
    "sharp": "^0.35.3",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.9",
    "three": "0.185.1",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.13.5",
    "@types/three": "0.185.1",
    "@types/yauzl": "^2.10.3",
    "bun-types": "^1.2.20",
    "fflate": "^0.8.2",
    "tailwindcss": "^4.1.11",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^7.0.6",
    "vite-plugin-solid": "^2.11.8",
    "eslint-plugin-solid": "^0.14.5",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "oxlint-tsgolint": "^0.16.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14"
}
