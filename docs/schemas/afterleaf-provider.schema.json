{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterleaf.dev/schemas/afterleaf-provider.schema.json",
  "title": "Afterleaf content provider",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "entry", "descriptor"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "apiVersion": {
      "const": 1
    },
    "kind": {
      "const": "afterleaf-content-provider"
    },
    "entry": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:mjs|cjs|js|mts|cts|ts)$"
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentKinds",
        "defaultBlockedTags",
        "defaultLanguages",
        "defaultQuery",
        "id",
        "name",
        "queryHelp",
        "queryLabel",
        "queryPlaceholder",
        "requiresLanguageTag",
        "summary"
      ],
      "properties": {
        "contentKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["anthology", "commercial-volume", "doujinshi", "magazine"]
          }
        },
        "defaultBlockedTags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "defaultLanguages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["english", "japanese"]
          }
        },
        "defaultQuery": {
          "type": "string",
          "maxLength": 100
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "queryHelp": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "queryLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "queryPlaceholder": {
          "type": "string",
          "maxLength": 500
        },
        "requiresLanguageTag": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
